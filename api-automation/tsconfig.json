{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "test-data/**/*.ts",
    "jest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "reports",
    "coverage",
    "artifacts"
  ]
}
